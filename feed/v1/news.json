      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:3pzepjafmdqgrchkqdypeuea/bafkreie6jgmqvjr3y7jkvl5wzd77pgev4tvpxtnowwpmak3chtpvnemdga",
