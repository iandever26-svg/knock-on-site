    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:6bc4kwdt7yiy7nwvz5md3hvx/app.bsky.feed.post/3mxi2ycezrk2h",
      "text": "Post-match press conference 🎥\n\"We didn't go fishing with dynamite, we were strategic and patient. I was pleased with the maturity to action what we needed to under pressure. We feel like we did a bit of everything today and we took our chances.\" - Mark Jones\n🎞️ youtu.be/VC5QXNx1JjM",
      "author": "Ospreys Rugby",
      "handle": "ospreysofficial.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:6bc4kwdt7yiy7nwvz5md3hvx/bafkreif3alq7ds6ovtohg4i53b2p2zyp2mfjgboaqzsqtfdxgxekue2joi",
      "url": "https://bsky.app/profile/ospreysofficial.bsky.social/post/3mxi2ycezrk2h",
