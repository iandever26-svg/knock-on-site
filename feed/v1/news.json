      "source": "harpinonrugby.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:kbwtbs2mqfxm4om4l7h7b2r6/app.bsky.feed.post/3mxjjkbsuzs2w",
      "text": "Can I tempt you with another Harlequins long-read?\nSpent the week talking to sources inside and outside the club about the obvious problems, the solutions, and just how deep this rebuild is. observer.co.uk/news/sport/a...",
      "author": "Ben Coles",
      "handle": "bencoles.bsky.social",
