    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:7azxdiemtvd7otuvlaeddz7p/app.bsky.feed.post/3mxi45iekjz2j",
      "text": "Post match chat with Stuart Lancaster 🟢🦅\n#OneConnacht",
      "author": "Connacht Rugby",
      "handle": "connachtrugbai.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:7azxdiemtvd7otuvlaeddz7p/bafkreidpaf4huzx5eselthu4md6z46ho6zni46nu3gflikegpybr4rysgu",
      "url": "https://bsky.app/profile/connachtrugbai.bsky.social/post/3mxi45iekjz2j",
      "publishedAt": "2026-10-09T23:15:40.693Z",
      "thumbnail": "https://video.bsky.app/watch/did%3Aplc%3A7azxdiemtvd7otuvlaeddz7p/bafkreidzcm6qzg55iwso5xr5n76yiomded23f36vzwuhbsqb6rdzu6bpee/thumbnail.jpg",
