    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:3pzepjafmdqgrchkqdypeuea/app.bsky.feed.post/3mxmeajonys27",
      "text": "Jake Dalziel made Newcastle history this afternoon on his PREM debut against Exeter\nAnd the teenager caught the eye of a couple of former British & Irish Lions despite defeat at Sandy Park\n🔗 shorturl.at/WvS3M",
      "author": "Scotland Rugby News",
      "handle": "scotlandrugbynews.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:3pzepjafmdqgrchkqdypeuea/bafkreif6g7jwyai2bngdxa3yek5mioziprgypfj3hvtxrlme6silqltyba",
      "url": "https://bsky.app/profile/scotlandrugbynews.bsky.social/post/3mxmeajonys27",
      "publishedAt": "2026-10-11T15:51:12.085Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:3pzepjafmdqgrchkqdypeuea/bafkreifmdj3dcbuwtb7wbgsopmlkar767x3q2kb6wa2h7f45twrr2eoehm",
