      "type": "bluesky",
      "id": "bsky:at://did:plc:bgeqymeltxrtny34aikxe4vy/app.bsky.feed.post/3mxf4kr3eib2p",
      "text": "Our view in 48 hours 🔥\nWe will be celebrating with a pre-game Homecoming Ceremony this Saturday ahead of the players running out for our first home game of the 2026/27 season.\n🎟️ Join us! Tickets available at https://bit.ly/3UsT8jJ",
      "author": "Leinster Rugby",
      "handle": "leinsterrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreidewh6iscgzmp56acshzhwoixyjoxxld6vj6bi76zvuyirnaqf66y",
      "url": "https://bsky.app/profile/leinsterrugby.bsky.social/post/3mxf4kr3eib2p",
      "publishedAt": "2026-10-08T18:45:07.165Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreiajabscsbgegemco6kw66kvizyoxjytjm7dixr4nblpbbqdffo3sa",
