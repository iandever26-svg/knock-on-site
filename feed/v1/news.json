      "thumbnail": null,
      "source": "bencoles.bsky.social"
    },
    {
      "type": "youtube",
      "id": "yt:iiwYREOouG0",
      "title": "Behind-The-Scenes | URC Round Three | Zebre Away",
      "author": "Edinburgh Rugby",
      "avatar": null,
      "url": "https://www.youtube.com/watch?v=iiwYREOouG0",
      "publishedAt": "2026-10-09T17:07:26.000Z",
      "thumbnail": "https://i2.ytimg.com/vi/iiwYREOouG0/hqdefault.jpg",
      "source": "UC5QfHoca5UPU3IU8XRw6FWg"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:7azxdiemtvd7otuvlaeddz7p/app.bsky.feed.post/3mxhfkbp7b72u",
      "text": "We're at Scotstoun as two of the 🐐 get everything set 🟢🦅\n#GLAvCON | #BKTURC",
