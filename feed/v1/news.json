    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:6bc4kwdt7yiy7nwvz5md3hvx/app.bsky.feed.post/3mx774gg7ts23",
      "text": "We've got a new phone number 📞\nOspreys' new Ticket Office number is live. You can contact the ticket office on: 01792 424242 ☎️\nOpening Hours: 10 - 4pm Monday to Friday 🕑\nThe old phone line is being disconnected and is now unavailable.\n#OurBloodIsBlack",
      "author": "Ospreys Rugby",
      "handle": "ospreysofficial.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:6bc4kwdt7yiy7nwvz5md3hvx/bafkreigpjt7htxjessl67aklbduktjfrq7tdqzxatmqdozcvpp2nnjhdda",
      "url": "https://bsky.app/profile/ospreysofficial.bsky.social/post/3mx774gg7ts23",
