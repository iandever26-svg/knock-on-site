      "handle": "dragonsrfc.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:76m24vhrsckzqfi33uyt6snv/bafkreihzvwyirklqwchsdtgblhclnw6rfqviodnvjitltqmj6wyvtix6oi",
