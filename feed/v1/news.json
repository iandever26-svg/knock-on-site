    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:bgeqymeltxrtny34aikxe4vy/app.bsky.feed.post/3mx7mir65lq2v",
      "text": "Back to rainy training sessions 🌧️\nJoin us for our homecoming match this Saturday at Laya Arena! Tickets available at https://bit.ly/3UsT8jJ",
      "author": "Leinster Rugby",
      "handle": "leinsterrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreidewh6iscgzmp56acshzhwoixyjoxxld6vj6bi76zvuyirnaqf66y",
      "url": "https://bsky.app/profile/leinsterrugby.bsky.social/post/3mx7mir65lq2v",
      "publishedAt": "2026-10-06T14:14:21.594Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreiezrpahkymtqdefveb24bbs4ljgbej7mqjil6xivbigkzv3uh2o2q",
      "source": "leinsterrugby.bsky.social"
