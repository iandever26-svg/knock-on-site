      "url": "https://bsky.app/profile/connachtrugbai.bsky.social/post/3mxhplg6fpr2j",
      "publishedAt": "2026-10-09T19:30:49.662Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:7azxdiemtvd7otuvlaeddz7p/bafkreiecajewziyxne24eo2n2g77fuyo6nkgl4gndaqw3pmhyidjepjwae",
      "source": "connachtrugbai.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:kbwtbs2mqfxm4om4l7h7b2r6/app.bsky.feed.post/3mxhni27tyc24",
      "text": "This Gloucester pack: enjoyable. George Skivington getting the dominant maul and physicality he wanted back on day one.",
      "author": "Ben Coles",
      "handle": "bencoles.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:kbwtbs2mqfxm4om4l7h7b2r6/bafkreihnbnflj5pmzn2vw5tula7bf7hay7nsutvg5e7suz6y2bnoob5p2a",
