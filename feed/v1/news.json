    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:7azxdiemtvd7otuvlaeddz7p/app.bsky.feed.post/3mx2fi4tkbd2r",
      "text": "R3️⃣ away to @GlasgowWarriors 🏴󠁧󠁢󠁳󠁣󠁴󠁿\n#OneConnacht",
      "author": "Connacht Rugby",
      "handle": "connachtrugbai.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:7azxdiemtvd7otuvlaeddz7p/bafkreidpaf4huzx5eselthu4md6z46ho6zni46nu3gflikegpybr4rysgu",
      "url": "https://bsky.app/profile/connachtrugbai.bsky.social/post/3mx2fi4tkbd2r",
      "publishedAt": "2026-10-04T12:25:25.202Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:7azxdiemtvd7otuvlaeddz7p/bafkreid5s3k7v4otwutwsyq2uwo2hmdybomkorcccqd43qzuqpklo6d5ia",
      "source": "connachtrugbai.bsky.social"
    },
    {
      "type": "youtube",
      "id": "yt:ZfZNsixX2kc",
      "title": "Charlie O’Shea Post-Match Bulls 🎙️",
      "author": "Munster Rugby",
      "avatar": null,
      "url": "https://www.youtube.com/watch?v=ZfZNsixX2kc",
      "publishedAt": "2026-10-04T11:45:12.000Z",
      "thumbnail": "https://i3.ytimg.com/vi/ZfZNsixX2kc/hqdefault.jpg",
      "source": "UC7991AZNku42o3Y36kUZOJA"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ouvin3vruox2v2t674dym2c5/app.bsky.feed.post/3mx2aui5f4s2b",
      "text": "Just to counter some bizarre comments.\nThe 7,231 at CAP on Friday was Cardiff’s 3rd best home crowd for a Zebre game.\nThe top two came in Zebre’s first seasons of 12/13 and 13/14 before it was obvious they are not competitive.\nCrowds at CAP are on the up and up.",
      "author": "Cardiff Rugby Life",
      "handle": "cardiffrugbylife.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ouvin3vruox2v2t674dym2c5/bafkreifwhig3c235gkfloyju2rzwylbbjo3sp6xo57fhnk2ib7ywn7i37i",
      "url": "https://bsky.app/profile/cardiffrugbylife.bsky.social/post/3mx2aui5f4s2b",
      "publishedAt": "2026-10-04T11:02:51.303Z",
      "thumbnail": null,
      "source": "cardiffrugbylife.bsky.social"
    },
    {
      "type": "youtube",
      "id": "yt:UZE1Ayns-3s",
      "title": "Inside Matchday | URC Round Two | Stormers",
      "author": "Edinburgh Rugby",
      "avatar": null,
      "url": "https://www.youtube.com/watch?v=UZE1Ayns-3s",
      "publishedAt": "2026-10-04T10:00:25.000Z",
      "thumbnail": "https://i2.ytimg.com/vi/UZE1Ayns-3s/hqdefault.jpg",
      "source": "UC5QfHoca5UPU3IU8XRw6FWg"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:bgeqymeltxrtny34aikxe4vy/app.bsky.feed.post/3mx25edoz732a",
      "text": "Just 6️⃣ days until we're finally back at Laya Arena! 🙌\n🎟️ Only a few tickets left for the homecoming game against Cardiff this Saturday: https://bit.ly/3UsT8jJ",
      "author": "Leinster Rugby",
      "handle": "leinsterrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreidewh6iscgzmp56acshzhwoixyjoxxld6vj6bi76zvuyirnaqf66y",
      "url": "https://bsky.app/profile/leinsterrugby.bsky.social/post/3mx25edoz732a",
      "publishedAt": "2026-10-04T10:00:08.423Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreieia5rqucoizv5lxywwohp5mkjan3ogrh76x2wojxfgetpiz472wu",
      "source": "leinsterrugby.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ffaez7heoltx2hhteuxtgxir/app.bsky.feed.post/3mwzygnmjbc2b",
      "text": "On Sunday mornings we share our notes from our feature match on Substack, including real-time screengrabs from our WhatsApp group throughout > jeffpagano.substack.com/p/sharks-v-l...",
      "author": "Harpin' On Rugby",
      "handle": "harpinonrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ffaez7heoltx2hhteuxtgxir/bafkreiehjzabtopas56abxv6eloubkkbqofmpztzciypn7d42ne3zbqjae",
      "url": "https://bsky.app/profile/harpinonrugby.bsky.social/post/3mwzygnmjbc2b",
      "publishedAt": "2026-10-04T08:31:57.342Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:ffaez7heoltx2hhteuxtgxir/bafkreifzpg4mayqknnuoplfgt64wqthe3thrwcd4htear6yep3sotqudhm",
      "source": "harpinonrugby.bsky.social"
    },
    {
      "type": "youtube",
      "id": "yt:VjZxhsJ4eL4",
      "title": "A powerful run, a spectacular try⚡",
      "author": "BenettonRugby",
      "avatar": null,
      "url": "https://www.youtube.com/watch?v=VjZxhsJ4eL4",
      "publishedAt": "2026-10-04T08:00:29.000Z",
      "thumbnail": "https://i3.ytimg.com/vi/VjZxhsJ4eL4/hqdefault.jpg",
      "source": "UCZWp6Nb9Rk6w6Dz_O_2nHqw"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ouvin3vruox2v2t674dym2c5/app.bsky.feed.post/3mwzv7cqvq22s",
      "text": "Cardiff have found a balance for the six fly-halves across the first team and Academy squad this season, but there are big decisions on the horizon that impact the future of the position and the reputation of the club.\ncardiffrugbylife.wales/2026/10/04/d...",
      "author": "Cardiff Rugby Life",
      "handle": "cardiffrugbylife.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ouvin3vruox2v2t674dym2c5/bafkreifwhig3c235gkfloyju2rzwylbbjo3sp6xo57fhnk2ib7ywn7i37i",
      "url": "https://bsky.app/profile/cardiffrugbylife.bsky.social/post/3mwzv7cqvq22s",
      "publishedAt": "2026-10-04T07:34:09.846Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:ouvin3vruox2v2t674dym2c5/bafkreiei2o7ulsd5ju4kks2ugoezbxuug5ovqcaemuws27mm6wuhwj3qse",
      "source": "cardiffrugbylife.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:3pzepjafmdqgrchkqdypeuea/app.bsky.feed.post/3mwzthtc6uy2a",
      "text": "Kyle Rowe produced another outstanding Glasgow performance in Glasgow's draw with Ulster, furthering his claim for a Scotland place in the autumn\n🔗 shorturl.at/8qgZW",
      "author": "Scotland Rugby News",
      "handle": "scotlandrugbynews.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:3pzepjafmdqgrchkqdypeuea/bafkreif6g7jwyai2bngdxa3yek5mioziprgypfj3hvtxrlme6silqltyba",
      "url": "https://bsky.app/profile/scotlandrugbynews.bsky.social/post/3mwzthtc6uy2a",
      "publishedAt": "2026-10-04T07:03:06.962Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:3pzepjafmdqgrchkqdypeuea/bafkreibyubv3j7p475e74csfc6k26wl77bcdbbgevi452pfguziopaixda",
      "source": "scotlandrugbynews.bsky.social"
    },
    {
      "type": "youtube",
      "id": "yt:O4nTnSGdrvs",
      "title": "Munster v Vodacom Bulls | Highlights | Round 2 | URC 2026/27",
      "author": "United Rugby Championship",
      "avatar": null,
      "url": "https://www.youtube.com/watch?v=O4nTnSGdrvs",
      "publishedAt": "2026-10-03T21:01:05.000Z",
      "thumbnail": "https://i4.ytimg.com/vi/O4nTnSGdrvs/hqdefault.jpg",
      "source": "UC-S6cXyil4qbIPfb2hrcH4w"
    },
    {
      "type": "youtube",
      "id": "yt:3k-gB3Ch7To",
      "title": "Glasgow Warriors v Ulster | Highlights | Round 2 | 2026/27",
      "author": "United Rugby Championship",
      "avatar": null,
      "url": "https://www.youtube.com/watch?v=3k-gB3Ch7To",
      "publishedAt": "2026-10-03T19:45:37.000Z",
      "thumbnail": "https://i4.ytimg.com/vi/3k-gB3Ch7To/hqdefault.jpg",
      "source": "UC-S6cXyil4qbIPfb2hrcH4w"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:bgeqymeltxrtny34aikxe4vy/app.bsky.feed.post/3mwykud6bzk2q",
      "text": "⚡ Robbie Henshaw, Thomas Clarkson and Andrew Osborne all crossed for tries as we fell to a 26-20 bonus-point defeat in Durban\n📰 Read the match report: https://bit.ly/3U1wDCx\n#SHAvLEI",
      "author": "Leinster Rugby",
      "handle": "leinsterrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreidewh6iscgzmp56acshzhwoixyjoxxld6vj6bi76zvuyirnaqf66y",
      "url": "https://bsky.app/profile/leinsterrugby.bsky.social/post/3mwykud6bzk2q",
      "publishedAt": "2026-10-03T18:56:23.913Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:bgeqymeltxrtny34aikxe4vy/bafkreibwzogmvzf4tuufuauxjvcnz3jljkdb5654dg72punf4a757nudpm",
      "source": "leinsterrugby.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ffaez7heoltx2hhteuxtgxir/app.bsky.feed.post/3mwyiydwoyc2w",
      "text": "Second week in a row we pulled a late try out of the bag.  In the end it wasn't the scrums that did for us, could have won that with more accuracy in 22 but again plenty to be happy with, esp Sam's shift.  Thought Sharks might have gotten 2nd half card but still deserved win.  #SHAvLEI",
      "author": "Harpin' On Rugby",
      "handle": "harpinonrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ffaez7heoltx2hhteuxtgxir/bafkreiehjzabtopas56abxv6eloubkkbqofmpztzciypn7d42ne3zbqjae",
      "url": "https://bsky.app/profile/harpinonrugby.bsky.social/post/3mwyiydwoyc2w",
      "publishedAt": "2026-10-03T18:22:51.564Z",
      "thumbnail": null,
      "source": "harpinonrugby.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:wizadpqsar4meknsnx7s3rms/app.bsky.feed.post/3mwyilu3av2un",
      "text": "Good BP win for the Sharks against Leinster. Champs came back in the third quarter, but the returning Boks made a big impact at the death.\nLeinster head back to Ireland with 3 log points from 2 matches.",
      "author": "Jon Cardinelli",
      "handle": "joncardinelli.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:wizadpqsar4meknsnx7s3rms/bafkreicmmiirqk2ft7xymnjwhs66pxlm4ttg4u2v7vqg26qpvuchxm5nri",
      "url": "https://bsky.app/profile/joncardinelli.bsky.social/post/3mwyilu3av2un",
      "publishedAt": "2026-10-03T18:15:52.284Z",
      "thumbnail": null,
      "source": "joncardinelli.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:mqdmx5o74xrnl4jwd7eroh35/app.bsky.feed.post/3mwyiadnr7k2t",
      "text": "Not convinced \"driven backwards by Jamie Dobie\" is a phrase you'd ever want to hear used about yourself",
      "author": "Scottish Rugby Podcast",
      "handle": "scotrugbypod.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:mqdmx5o74xrnl4jwd7eroh35/bafkreifbllydjgwnuwniseg4xdzqgul2n6mvpnva2ybemkowieg7tp4h7u",
      "url": "https://bsky.app/profile/scotrugbypod.bsky.social/post/3mwyiadnr7k2t",
      "publishedAt": "2026-10-03T18:09:25.966Z",
      "thumbnail": null,
      "source": "scotrugbypod.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ffaez7heoltx2hhteuxtgxir/app.bsky.feed.post/3mwyhzi7xx22w",
      "text": "How many Sharks penalties since the warning? #SHAvLEI",
      "author": "Harpin' On Rugby",
      "handle": "harpinonrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ffaez7heoltx2hhteuxtgxir/bafkreiehjzabtopas56abxv6eloubkkbqofmpztzciypn7d42ne3zbqjae",
      "url": "https://bsky.app/profile/harpinonrugby.bsky.social/post/3mwyhzi7xx22w",
      "publishedAt": "2026-10-03T18:05:35.874Z",
      "thumbnail": null,
      "source": "harpinonrugby.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ffaez7heoltx2hhteuxtgxir/app.bsky.feed.post/3mwyfico5j22w",
      "text": "3 areas proving the difference here, the scrum, the scrum and oh yeah, the scrum.   Not sure du Toit is 100% legal but it's always about what you get away with and we need a solution quick.  We do look good with the ball but badly needed a lead at the break.  Very much uphill from here. #SHAvLEI",
      "author": "Harpin' On Rugby",
      "handle": "harpinonrugby.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ffaez7heoltx2hhteuxtgxir/bafkreiehjzabtopas56abxv6eloubkkbqofmpztzciypn7d42ne3zbqjae",
      "url": "https://bsky.app/profile/harpinonrugby.bsky.social/post/3mwyfico5j22w",
      "publishedAt": "2026-10-03T17:20:12.139Z",
      "thumbnail": null,
      "source": "harpinonrugby.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:mqdmx5o74xrnl4jwd7eroh35/app.bsky.feed.post/3mwydxbtl3k2t",
      "text": "Big Staff deciding to back the fact that he was twice the size of the defender instead of giving it to one of the TWO faster guys either side of him butchered a stuck on try there.\nYou never go Full Duhan",
      "author": "Scottish Rugby Podcast",
      "handle": "scotrugbypod.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:mqdmx5o74xrnl4jwd7eroh35/bafkreifbllydjgwnuwniseg4xdzqgul2n6mvpnva2ybemkowieg7tp4h7u",
      "url": "https://bsky.app/profile/scotrugbypod.bsky.social/post/3mwydxbtl3k2t",
      "publishedAt": "2026-10-03T16:52:47.101Z",
      "thumbnail": null,
      "source": "scotrugbypod.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ouvin3vruox2v2t674dym2c5/app.bsky.feed.post/3mwybsjuvbk2c",
      "text": "By my reckoning that’s Cardiff’s biggest ever winning margin at Eugene Cross Park.\nOnly scored more points there on one occasion, an 18-61 win in March 1984, which technically would take the margin record in new money but we’ll gloss over that…",
      "author": "Cardiff Rugby Life",
      "handle": "cardiffrugbylife.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ouvin3vruox2v2t674dym2c5/bafkreifwhig3c235gkfloyju2rzwylbbjo3sp6xo57fhnk2ib7ywn7i37i",
      "url": "https://bsky.app/profile/cardiffrugbylife.bsky.social/post/3mwybsjuvbk2c",
      "publishedAt": "2026-10-03T16:14:20.278Z",
      "thumbnail": null,
      "source": "cardiffrugbylife.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ouvin3vruox2v2t674dym2c5/app.bsky.feed.post/3mwy6szg5ts2c",
      "text": "Ebbw Vale 14-59 Cardiff FT\nWaw.\nA try of the season fest at EXP as the Rags go on a second half rampage for a super duper bonus point and statement win.\nWhat a performance.\n#BlueAndBlacks",
      "author": "Cardiff Rugby Life",
      "handle": "cardiffrugbylife.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ouvin3vruox2v2t674dym2c5/bafkreifwhig3c235gkfloyju2rzwylbbjo3sp6xo57fhnk2ib7ywn7i37i",
      "url": "https://bsky.app/profile/cardiffrugbylife.bsky.social/post/3mwy6szg5ts2c",
      "publishedAt": "2026-10-03T15:20:55.347Z",
      "thumbnail": null,
      "source": "cardiffrugbylife.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:6bc4kwdt7yiy7nwvz5md3hvx/app.bsky.feed.post/3mwy5qq7wis2o",
      "text": "🎥POST-MATCH PRESS CONFERENCE\n\"I was happy to be going in at half time on the scoreboard.\nWe just couldn't get a foothold in the second half: it was hard to get over the gainline and get any speed of ball.\nWe've got to show more than fight when we get back home.\" - Mark Jones\n#OurBloodIsBlack",
      "author": "Ospreys Rugby",
      "handle": "ospreysofficial.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:6bc4kwdt7yiy7nwvz5md3hvx/bafkreigpjt7htxjessl67aklbduktjfrq7tdqzxatmqdozcvpp2nnjhdda",
      "url": "https://bsky.app/profile/ospreysofficial.bsky.social/post/3mwy5qq7wis2o",
      "publishedAt": "2026-10-03T15:01:44.855Z",
      "thumbnail": "https://video.bsky.app/watch/did%3Aplc%3A6bc4kwdt7yiy7nwvz5md3hvx/bafkreif3uumgdx7sndyn7pvv5q3cdmwsumatsxmimmi3hhncitmfjzbhq4/thumbnail.jpg",
      "source": "ospreysofficial.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:6bc4kwdt7yiy7nwvz5md3hvx/app.bsky.feed.post/3mwy52xvjfc2o",
      "text": "📰 MATCH REPORT\nThe first half in Joahnnesburg was a tight encounter that saw the Ospreys wrestle control after two late tries, but the Lions dominated in the second despite a final Ospreys score.\nRead more 🔗 ospreys.info/46YZuKI\n#OurBloodIsBlack",
      "author": "Ospreys Rugby",
      "handle": "ospreysofficial.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:6bc4kwdt7yiy7nwvz5md3hvx/bafkreigpjt7htxjessl67aklbduktjfrq7tdqzxatmqdozcvpp2nnjhdda",
      "url": "https://bsky.app/profile/ospreysofficial.bsky.social/post/3mwy52xvjfc2o",
      "publishedAt": "2026-10-03T14:49:34.700Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:6bc4kwdt7yiy7nwvz5md3hvx/bafkreib62lp7akxecxb7uhazvh2dsikigrwqybzhxgatd5x37uu3oypw5q",
      "source": "ospreysofficial.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ouvin3vruox2v2t674dym2c5/app.bsky.feed.post/3mwy3gow2ms2c",
      "text": "Ebbw Vale 7-12 Cardiff HT\nThe Rags good value for the lead but some poor game management, a try conceded and a yellow card with clock red at the end of the half changes momentum going in at the break.\n#BlueAndBlacks",
      "author": "Cardiff Rugby Life",
      "handle": "cardiffrugbylife.bsky.social",
