    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:6bc4kwdt7yiy7nwvz5md3hvx/app.bsky.feed.post/3mxhxdeqyxs2h",
      "text": "Match Report: Ospreys score six tries in derby day win vs Dragons 🖤\nIt was a strong Ospreys performance as the squad scored six tries and secured an important bonus point away from home at Rodney Parade.\n📰 ospreys.info/4ifQN3Z",
      "author": "Ospreys Rugby",
      "handle": "ospreysofficial.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:6bc4kwdt7yiy7nwvz5md3hvx/bafkreif3alq7ds6ovtohg4i53b2p2zyp2mfjgboaqzsqtfdxgxekue2joi",
      "url": "https://bsky.app/profile/ospreysofficial.bsky.social/post/3mxhxdeqyxs2h",
      "publishedAt": "2026-10-09T21:49:29.986Z",
      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:6bc4kwdt7yiy7nwvz5md3hvx/bafkreifersb35ywv3bnhy7xnrgfqyqizlpaes6weqfktikcmyhmibeq7dq",
      "source": "ospreysofficial.bsky.social"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:7azxdiemtvd7otuvlaeddz7p/app.bsky.feed.post/3mxhx4i6se726",
      "text": "Full-time at Scotstoun.\n@KiaRenmore | #MovementThatInspires",
      "author": "Connacht Rugby",
      "handle": "connachtrugbai.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:7azxdiemtvd7otuvlaeddz7p/bafkreidpaf4huzx5eselthu4md6z46ho6zni46nu3gflikegpybr4rysgu",
