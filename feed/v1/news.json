    {
      "type": "youtube",
      "id": "yt:67r-6Iif1fg",
      "title": "WHAT DEFENDERS? 😮‍💨💨",
      "author": "United Rugby Championship",
      "avatar": null,
      "url": "https://www.youtube.com/watch?v=67r-6Iif1fg",
      "publishedAt": "2026-10-10T17:33:00.000Z",
      "thumbnail": "https://i3.ytimg.com/vi/67r-6Iif1fg/hqdefault.jpg",
      "source": "UC-S6cXyil4qbIPfb2hrcH4w"
    },
    {
      "type": "bluesky",
      "id": "bsky:at://did:plc:ouvin3vruox2v2t674dym2c5/app.bsky.feed.post/3mxjyqh7khs27",
      "text": "Would like to see Cardiff come out with some real intent and have a go at a Leinster side that could well be a little rusty tonight.\nNo shame in losing to a side packed with test quality on their big return home, but as long we can get into them early and worry them #LEIvCAR",
      "author": "Cardiff Rugby Life",
      "handle": "cardiffrugbylife.bsky.social",
      "avatar": "https://cdn.bsky.app/img/avatar/plain/did:plc:ouvin3vruox2v2t674dym2c5/bafkreifwhig3c235gkfloyju2rzwylbbjo3sp6xo57fhnk2ib7ywn7i37i",
