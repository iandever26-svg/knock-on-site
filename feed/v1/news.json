      "thumbnail": "https://cdn.bsky.app/img/feed_thumbnail/plain/did:plc:ffaez7heoltx2hhteuxtgxir/bafkreiegx7ysm4pzmm5ymwetwlmuhlupjlfgfiobxxg47oo7hedwrxzfbm",
